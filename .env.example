# App
PORT=3000
NODE_ENV=development
TZ=America/La_Paz

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tukiosco
DB_TEST_NAME=tukiosco_test
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Auth
# Use a strong random value in real environments.
JWT_SECRET=change-me
# Legacy fallback used by older auth code. Leave empty if JWT_SECRET is set.
SECRET_KEY=

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
PRESIGNED_URL_EXPIRES_IN=300
S3_UPLOAD_MAX_MB=5

# CORS / HTTP
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://10.0.2.2:3000
JSON_LIMIT=1mb

# Email password reset
EMAIL_USER=
EMAIL_PASS=
